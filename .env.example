# ==========================================
# FRONTEND CONFIGURATION (React / Vite)
# ==========================================
VITE_API_BASE_URL=http://localhost:8080/api
VITE_AI_SERVICE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=my_google_client_id_here.apps.googleusercontent.com

# ==========================================
# BACKEND CONFIGURATION (Spring Boot)
# ==========================================
PORT=8080
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/movietime?retryWrites=true&w=majority

# Google OAuth Credentials
GOOGLE_CLIENT_ID=my_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=my_google_client_secret_here

# JWT Authentication
JWT_SECRET=my_jwt_secret_key_here_must_be_at_least_256_bits
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# TMDB API Credentials
TMDB_API_KEY=my_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ---------- Mail Configuration ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=my-email@gmail.com
MAIL_PASSWORD=my-gmail-app-password

# CORS & Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ==========================================
# AI SERVICE CONFIGURATION (Python / FastAPI)
# ==========================================
AI_PORT=8000
GROQ_API_KEY=my_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b